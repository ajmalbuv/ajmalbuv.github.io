/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon-180x180.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
