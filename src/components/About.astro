---
import { siteData } from '../data/site';

const { experiences, education } = siteData;
---

<section
  id="about"
  class="py-8 sm:py-10 px-3.5 sm:px-6 lg:px-8 max-w-5xl 2xl:max-w-6xl mx-auto"
>
  <div class="mb-8 sm:mb-10">
    <span class="font-mono text-xs uppercase tracking-widest text-accent font-bold">
      Background &amp; Timeline
    </span>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-1">
      Experience &amp; Education
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
    <div class="min-w-0">
      <h3 class="text-xl font-semibold text-neutral-200 mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-accent shrink-0"></span>
        <span>Work Experience</span>
      </h3>

      <div class="space-y-8 relative before:absolute before:inset-y-0 before:inset-s-3 before:w-0.5 before:bg-neutral-800">
        {experiences.map((exp) => (
          <div class="relative z-10 ps-8 group min-w-0">
            <span class="absolute inset-s-1.5 top-1.5 -translate-x-1/2 rtl:translate-x-1/2 w-3 h-3 rounded-full border-2 border-accent bg-surface-bg group-hover:bg-accent transition-colors" />
            <div class="min-w-0 bg-surface-card border border-neutral-800/90 rounded-xl p-4 sm:p-5 hover:border-neutral-700 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2 min-w-0">
                <h4 class="text-base font-bold text-white wrap-break-word">{exp.role}</h4>
                <span class="font-mono text-xs text-accent font-medium tabular-nums shrink-0">
                  {exp.duration}
                </span>
              </div>
              <p class="text-sm font-medium text-neutral-400 mb-3 wrap-break-word">
                {exp.company}
              </p>
              <p class="text-sm text-neutral-300 leading-relaxed mb-3 wrap-break-word">
                {exp.description}
              </p>
              {exp.highlights && exp.highlights.length > 0 && (
                <ul class="list-disc list-inside space-y-1 text-xs text-neutral-400 wrap-break-word">
                  {exp.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="min-w-0">
      <h3 class="text-xl font-semibold text-neutral-200 mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-400 shrink-0"></span>
        <span>Education</span>
      </h3>

      <div class="space-y-6">
        {education.map((edu) => (
          <div class="relative z-10 min-w-0 bg-surface-card border border-neutral-800/90 rounded-xl p-4 sm:p-5 hover:border-neutral-700 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1 min-w-0">
              <h4 class="text-base font-bold text-white wrap-break-word">{edu.degree}</h4>
              <span class="font-mono text-xs text-neutral-400 font-medium tabular-nums shrink-0">
                {edu.duration}
              </span>
            </div>
            <p class="text-sm font-medium text-neutral-300 wrap-break-word">{edu.school}</p>
            <p class="text-xs text-neutral-400 mt-1 wrap-break-word">{edu.location}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
