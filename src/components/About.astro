---
import { siteData } from '../data/site';

const { experiences, education } = siteData;
---

<section
  id="about"
  class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl 2xl:max-w-6xl mx-auto"
>
  <div class="mb-8 sm:mb-10">
    <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
      Background &amp; Timeline
    </span>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-1">
      Experience &amp; Education
    </h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <div>
      <h3 class="text-xl font-semibold text-neutral-200 mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#fc7a00]"></span>
        <span>Work Experience</span>
      </h3>

      <div class="space-y-8 relative before:absolute before:inset-0 before:left-3 before:w-0.5 before:bg-neutral-800">
        {experiences.map((exp) => (
          <div class="relative pl-8 group">
            <span class="absolute left-1.5 top-1.5 -translate-x-1/2 w-3 h-3 rounded-full border-2 border-[#fc7a00] bg-[#0a0a0a] group-hover:bg-[#fc7a00] transition-colors" />
            <div class="bg-[#121212] border border-neutral-800/90 rounded-xl p-5 hover:border-neutral-700 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
                <h4 class="text-base font-bold text-white">{exp.role}</h4>
                <span class="font-mono text-xs text-[#fc7a00] font-medium">
                  {exp.duration}
                </span>
              </div>
              <p class="text-sm font-medium text-neutral-400 mb-3">
                {exp.company}
              </p>
              <p class="text-sm text-neutral-300 leading-relaxed mb-3">
                {exp.description}
              </p>
              {exp.highlights && exp.highlights.length > 0 && (
                <ul class="list-disc list-inside space-y-1 text-xs text-neutral-400">
                  {exp.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div>
      <h3 class="text-xl font-semibold text-neutral-200 mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-neutral-400"></span>
        <span>Education</span>
      </h3>

      <div class="space-y-6">
        {education.map((edu) => (
          <div class="bg-[#121212] border border-neutral-800/90 rounded-xl p-5 hover:border-neutral-700 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-1">
              <h4 class="text-base font-bold text-white">{edu.degree}</h4>
              <span class="font-mono text-xs text-neutral-400 font-medium">
                {edu.duration}
              </span>
            </div>
            <p class="text-sm font-medium text-neutral-300">{edu.school}</p>
            <p class="text-xs text-neutral-500 mt-1">{edu.location}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
