---
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';

const { personal } = siteData;
---

<section id="contact" class="py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
  <div class="bg-linear-to-br from-[#141414] to-[#0d0d0d] border border-neutral-800 rounded-3xl p-8 sm:p-12 text-center relative overflow-hidden">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-48 bg-[#fc7a00]/10 blur-3xl pointer-events-none rounded-full"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-xl mx-auto">
      <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
        Get In Touch
      </span>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mt-2 mb-4">
        Let's Connect.
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base leading-relaxed mb-8">
        I am always open to discussing new opportunities, systems architecture, Flutter projects, or open-source collaborations.
      </p>
      <div class="mb-10">
        <a
          href={`mailto:${personal.contact.email}`}
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#fc7a00] text-black font-mono font-bold text-base rounded-full hover:bg-[#ff9429] transition-all transform hover:scale-105 shadow-xl shadow-[#fc7a00]/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <Icon name="mdi:email-outline" class="w-5 h-5" />
          <span>{personal.contact.email}</span>
        </a>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6 pt-6 border-t border-neutral-800/80 text-sm text-neutral-400">
        <a
          href={`tel:${personal.contact.phone.replace(/\s+/g, '')}`}
          class="inline-flex items-center gap-2 hover:text-[#fc7a00] transition-colors"
        >
          <Icon name="mdi:phone" class="w-4 h-4 text-neutral-500" />
          <span>{personal.contact.phone}</span>
        </a>
        <span class="text-neutral-700">•</span>
        <span class="inline-flex items-center gap-2">
          <Icon name="mdi:map-marker" class="w-4 h-4 text-neutral-500" />
          <span>{personal.contact.location}</span>
        </span>
      </div>
    </div>
  </div>
</section>
