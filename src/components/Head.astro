---
import { siteData } from '../data/site';
import geistSansFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  canonicalURL?: URL | undefined;
}

const {
  title = `${siteData.personal.name} | ${siteData.personal.title}`,
  description = siteData.personal.bio,
  image = siteData.personal.avatar.src,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://ajmalbuv.pages.dev';
const avatarFullUrl = new URL(image, siteUrl).toString();

// JSON-LD Person & WebSite schemas matching 0day/portfolio specifications
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: [
        siteData.personal.name,
        siteData.personal.handle,
        'Ajmal Aju',
        '_.aju',
      ],
      image: avatarFullUrl,
      jobTitle: [
        'Software Engineer',
        'Systems Builder',
        'Flutter Developer',
        'Full Stack Developer',
      ],
      description: description,
      url: siteUrl,
      email: siteData.personal.contact.email,
      sameAs: siteData.personal.contact.socials.map((s) => s.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: `${siteData.personal.name} | ${siteData.personal.title}`,
      description: siteData.personal.bio,
      publisher: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: 'en',
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>

<link
  rel="preload"
  href={geistSansFont}
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={siteData.personal.name} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a0a0a" />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={avatarFullUrl} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={avatarFullUrl} />

<link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
<link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
<link
  rel="apple-touch-icon"
  href="/apple-touch-icon-180x180.png"
  sizes="180x180"
/>
<link rel="manifest" href="/manifest.json" />
<link rel="dns-prefetch" href="https://media.githubusercontent.com" />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
