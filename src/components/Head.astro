---
import { siteData } from '../data/site';
import geistSansFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  imageWidth?: number | string | undefined;
  imageHeight?: number | string | undefined;
  imageType?: string | undefined;
  canonicalURL?: URL | undefined;
  type?: 'website' | 'article' | undefined;
}

const {
  title = `${siteData.personal.name} | ${siteData.personal.title}`,
  description = siteData.personal.bio,
  image = '/og-image.png',
  imageAlt = `${siteData.personal.name} | ${siteData.personal.title}`,
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const ogImageFullUrl = new URL(image, siteUrl).toString();
const avatarFullUrl = new URL(siteData.personal.avatar.src, siteUrl).toString();
const twitterHandle = `@${siteData.personal.handle}`;

// JSON-LD Person & WebSite schemas matching 0day/portfolio specifications
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: siteData.personal.name,
      alternateName: [siteData.personal.handle, 'Ajmal Aju', '_.aju'],
      image: avatarFullUrl,
      jobTitle: [
        'Software Engineer',
        'Systems Builder',
        'Flutter Developer',
        'Full Stack Developer',
      ],
      description: description,
      url: siteUrl,
      email: siteData.personal.contact.email,
      sameAs: siteData.personal.contact.socials.map((s) => s.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: `${siteData.personal.name} | ${siteData.personal.title}`,
      description: siteData.personal.bio,
      publisher: {
        '@id': `${siteUrl}/#person`,
      },
      inLanguage: 'en',
    },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>

<link
  rel="preload"
  href={geistSansFont}
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={siteData.personal.name} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0a0a0a" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:site_name" content={siteData.personal.name} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageFullUrl} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageFullUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />

<!-- Favicons & App Icons -->
<link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
<link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
<link
  rel="apple-touch-icon"
  href="/apple-touch-icon-180x180.png"
  sizes="180x180"
/>
<link rel="manifest" href="/manifest.json" />
<link rel="dns-prefetch" href="https://media.githubusercontent.com" />

<!-- Structured Data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
