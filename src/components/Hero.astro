---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';

const { personal } = siteData;
const resumeViewerUrl = `https://docs.google.com/gview?url=${encodeURIComponent(personal.resumeUrl)}`;
---

<section
  id="home"
  class="relative w-full min-h-[85dvh] bg-white text-black flex flex-col items-center justify-center overflow-hidden py-10 sm:py-16 px-4 sm:px-6 lg:px-8"
>
  <div
    id="particles-js"
    class="absolute inset-0 w-full h-full z-0 pointer-events-auto overflow-hidden touch-pan-y"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-6 sm:gap-8 md:gap-14 my-auto">
    <div class="shrink-0">
      <Image
        src={personal.avatar}
        alt={`${personal.name} (${personal.handle})`}
        class="w-32 h-32 sm:w-44 sm:h-44 md:w-52 md:h-52 rounded-full object-cover shadow-xl transition-transform duration-300 hover:scale-105"
        width={208}
        height={208}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-black font-sans leading-none mb-2">
        {personal.handle}
      </h1>
      <h2 class="text-xl sm:text-3xl font-semibold text-neutral-800 font-mono mb-2">
        {personal.name}
      </h2>
      <p class="font-mono text-xs sm:text-base md:text-lg text-neutral-600 mb-6 max-w-md">
        {personal.title}
      </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 sm:gap-4">
        <div class="flex items-center gap-1.5 sm:gap-2">
          {personal.contact.socials.map((social) => (
            <div class="group relative inline-flex items-center justify-center">
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.ariaLabel}
                class="p-2 sm:p-2.5 rounded-lg text-black hover:text-[#fc7a00] hover:bg-neutral-100 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00]"
              >
                <Icon name={social.icon} class="w-5 h-5 sm:w-6 sm:h-6" />
              </a>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-neutral-900 px-2 py-1 font-mono text-xs text-neutral-200 opacity-0 shadow-lg border border-neutral-800 transition-opacity duration-200 group-hover:opacity-100 group-has-focus-visible:opacity-100 z-50"
              >
                {social.name}
              </span>
            </div>
          ))}
        </div>

        <span
          class="hidden sm:inline-block w-px h-6 bg-neutral-300 mx-1"
          aria-hidden="true"
        ></span>

        <button
          id="download-resume-btn"
          data-resume-url={personal.resumeUrl}
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 sm:px-5 sm:py-2.5 bg-black text-white font-mono text-xs sm:text-sm font-semibold rounded-full hover:bg-[#fc7a00] hover:text-black transition-colors duration-200 cursor-pointer shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] aria-busy:pointer-events-none aria-busy:cursor-wait aria-busy:opacity-70"
        >
          <Icon name="mdi:file-document-outline" class="w-4 h-4" />
          <span>Download Resume</span>
        </button>
        <a
          href={resumeViewerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 sm:px-4 sm:py-2 border border-neutral-300 text-neutral-800 font-mono text-xs font-medium rounded-full hover:border-black hover:text-black transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00]"
        >
          <Icon name="mdi:open-in-new" class="w-3.5 h-3.5" />
          <span>View Online</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    type Container,
    type ISourceOptions,
    tsParticles,
  } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  const particlesConfig: ISourceOptions = {
    fpsLimit: 60,
    particles: {
      number: {
        value: 70,
        density: {
          enable: true,
          width: 800,
          height: 800,
        },
        limit: {
          mode: 'delete',
          value: 75,
        },
      },
      color: {
        value: '#000000',
      },
      shape: {
        type: 'circle',
      },
      opacity: {
        value: { min: 0.1, max: 0.5 },
      },
      size: {
        value: { min: 0.1, max: 6 },
      },
      links: {
        enable: true,
        distance: 150,
        color: '#000000',
        opacity: 0.4,
        width: 3,
      },
      move: {
        enable: true,
        speed: 1.0,
        direction: 'none',
        random: false,
        straight: false,
        outModes: 'out',
      },
    },
    interactivity: {
      detectsOn: 'canvas',
      events: {
        onHover: {
          enable: true,
          mode: 'grab',
        },
        onClick: {
          enable: false,
          mode: 'push',
        },
      },
      modes: {
        grab: {
          distance: 194.89853095232286,
          links: {
            opacity: 1,
          },
        },
        bubble: {
          distance: 400,
          size: 40,
          duration: 2,
          opacity: 8,
          speed: 3,
        },
        repulse: {
          distance: 200,
          duration: 0.4,
        },
        push: {
          quantity: 4,
        },
        remove: {
          quantity: 2,
        },
      },
    },
    detectRetina: true,
  };

  let pluginsPromise: Promise<void> | null = null;
  let particleContainer: Container | undefined;

  async function initParticles() {
    const container = document.getElementById('particles-js');
    if (!container || container.dataset['initialized']) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    container.dataset['initialized'] = 'true';

    try {
      if (!pluginsPromise) {
        pluginsPromise = loadSlim(tsParticles);
      }
      await pluginsPromise;
      const c = await tsParticles.load({
        id: 'particles-js',
        options: particlesConfig,
      });
      if (!container.isConnected) {
        c?.destroy();
        return;
      }
      particleContainer = c;
    } catch (err) {
      pluginsPromise = null;
      delete container.dataset['initialized'];
      console.warn('tsParticles initialization error:', err);
    }
  }

  function initResume() {
    const resumeBtn = document.getElementById('download-resume-btn');
    if (!resumeBtn || resumeBtn.dataset['initialized']) return;
    resumeBtn.dataset['initialized'] = 'true';

    resumeBtn.addEventListener('click', async () => {
      const resumeUrl = resumeBtn.dataset['resumeUrl'];
      if (!resumeUrl || resumeBtn.getAttribute('aria-busy') === 'true') return;

      const originalHtml = resumeBtn.innerHTML;
      resumeBtn.setAttribute('aria-busy', 'true');
      resumeBtn.innerHTML = '<span>Downloading...</span>';

      try {
        const res = await fetch(resumeUrl);
        if (!res.ok) throw new Error('Fetch failed');
        const blob = await res.blob();
        const blobUrl = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = blobUrl;
        link.download = 'AjmalBasheer-Resume.pdf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => window.URL.revokeObjectURL(blobUrl), 1000);
      } catch (err) {
        console.warn('Direct fallback on fetch error:', err);
        window.location.href = resumeUrl;
      } finally {
        resumeBtn.removeAttribute('aria-busy');
        resumeBtn.innerHTML = originalHtml;
      }
    });
  }

  const boot = () => {
    initParticles();
    initResume();
  };
  boot();
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => {
    particleContainer?.destroy();
    particleContainer = undefined;
  });
</script>
