---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { siteData } from "../data/site";

const { personal } = siteData;
const resumeViewerUrl = `https://docs.google.com/gview?url=${encodeURIComponent(personal.resumeUrl)}`;
---

<section
  id="home"
  class="relative w-full min-h-[85dvh] bg-white text-black flex flex-col items-center justify-center overflow-hidden py-10 sm:py-16 px-4 sm:px-6 lg:px-8"
>
  <div
    id="particles-js"
    class="absolute inset-0 w-full h-full z-0 pointer-events-auto overflow-hidden touch-pan-y"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-6 sm:gap-8 md:gap-14 my-auto">
    <div class="shrink-0">
      <Image
        src={personal.avatar}
        alt={`${personal.name} (${personal.handle})`}
        class="w-32 h-32 sm:w-44 sm:h-44 md:w-52 md:h-52 rounded-full object-cover object-top shadow-xl transition-[transform,scale] duration-300 motion-safe:hover:scale-105 motion-reduce:transition-none"
        width={208}
        height={208}
        widths={[208, 416]}
        sizes="(min-width: 768px) 208px, (min-width: 640px) 176px, 128px"
        format="webp"
        fit="cover"
        position="top"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </div>

    <div class="w-full min-w-0 flex flex-col items-center md:items-start text-center md:text-start">
      <h1 class="max-w-full wrap-break-word text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-black font-sans leading-none mb-2">
        {personal.handle}
      </h1>
      <h2 class="max-w-full wrap-break-word text-xl sm:text-3xl font-semibold text-neutral-800 font-mono mb-2">
        {personal.name}
      </h2>
      <p class="font-mono text-xs sm:text-base md:text-lg text-neutral-600 mb-6 max-w-md wrap-break-word">
        {personal.title}
      </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 sm:gap-4">
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
          {personal.contact.socials.map((social) => {
            const isExternal = social.url.startsWith("http");
            return (
              <div class="group relative inline-flex items-center justify-center">
                <a
                  href={social.url}
                  target={isExternal ? "_blank" : undefined}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                  aria-label={
                    isExternal
                      ? `${social.ariaLabel} (opens in new tab)`
                      : social.ariaLabel
                  }
                  class="min-w-11 min-h-11 flex items-center justify-center p-2 sm:p-2.5 rounded-lg text-black hover:text-accent-dark hover:bg-neutral-100 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-dark"
                >
                  <Icon
                    name={social.icon}
                    class="w-5 h-5 sm:w-6 sm:h-6"
                    aria-hidden="true"
                  />
                </a>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded bg-neutral-900 px-2 py-1 font-mono text-xs text-neutral-200 opacity-0 shadow-lg border border-neutral-800 transition-opacity duration-200 group-hover:opacity-100 group-has-focus-visible:opacity-100 z-50"
                >
                  {social.name}
                </span>
              </div>
            );
          })}
        </div>

        <span
          class="hidden sm:inline-block w-px h-6 bg-neutral-300 mx-1"
          aria-hidden="true"
        ></span>

        <button
          id="download-resume-btn"
          data-resume-url={personal.resumeUrl}
          type="button"
          aria-describedby="resume-status"
          class="inline-flex items-center justify-center gap-2 min-h-11 px-4 py-2 sm:px-5 sm:py-2.5 bg-black text-white font-mono text-xs sm:text-sm font-semibold rounded-full hover:bg-accent hover:text-black transition-[color,background-color,transform,scale] duration-200 cursor-pointer shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-dark disabled:pointer-events-none disabled:cursor-wait disabled:opacity-70 aria-busy:pointer-events-none aria-busy:cursor-wait aria-busy:opacity-70 motion-safe:active:scale-95 motion-reduce:transition-colors motion-reduce:duration-100"
        >
          <Icon
            name="mdi:file-document-outline"
            class="w-4 h-4 shrink-0"
            aria-hidden="true"
          />
          <span id="download-resume-text">Download Resume</span>
        </button>
        <span id="resume-status" class="sr-only" aria-live="polite"></span>
        <a
          href={resumeViewerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 min-h-11 px-3.5 py-2 sm:px-4 sm:py-2 border border-neutral-300 text-neutral-800 font-mono text-xs font-medium rounded-full hover:border-black hover:text-black transition-[color,border-color,transform,scale] duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-dark motion-safe:active:scale-95 motion-reduce:transition-colors motion-reduce:duration-100"
        >
          <Icon name="mdi:open-in-new" class="w-3.5 h-3.5 shrink-0" aria-hidden="true" />
          <span>View Online</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>

      <div
        id="resume-error"
        role="alert"
        hidden
        class="mt-3 w-full max-w-md rounded-xl border border-red-300 bg-red-50 px-3.5 py-2.5 text-start text-xs text-red-950 shadow-sm"
      >
        <p id="resume-error-msg" class="font-mono leading-relaxed wrap-break-word"></p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <button
            id="resume-retry-btn"
            type="button"
            class="inline-flex items-center justify-center min-h-11 px-3.5 py-2 rounded-lg bg-black text-white font-mono text-xs font-semibold hover:bg-accent hover:text-black transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-dark cursor-pointer"
          >
            Try again
          </button>
          <a
            href={personal.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1 min-h-11 px-3 py-2 rounded-lg border border-red-300 text-red-900 font-mono text-xs font-medium hover:bg-red-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-dark"
          >
            <span>Open PDF directly</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import type { Container, ISourceOptions } from "@tsparticles/engine";

  type ConnectionLike = { saveData?: boolean; effectiveType?: string };
  type WindowWithScheduler = Window & {
    scheduler?: { yield?: () => Promise<void> };
  };

  function isConstrainedConnection(): boolean {
    const conn = (navigator as Navigator & { connection?: ConnectionLike })
      .connection;
    return Boolean(
      conn?.saveData ||
        conn?.effectiveType === "slow-2g" ||
        conn?.effectiveType === "2g",
    );
  }

  function yieldToMain(): Promise<void> {
    const scheduler = (window as WindowWithScheduler).scheduler;
    if (typeof scheduler?.yield === "function") {
      return scheduler.yield();
    }
    return new Promise((resolve) => window.setTimeout(resolve, 0));
  }

  const getParticlesConfig = (isMobile: boolean): ISourceOptions => ({
    fpsLimit: isMobile ? 30 : 60,
    particles: {
      number: {
        value: isMobile ? 24 : 70,
        density: {
          enable: true,
          width: 800,
          height: 800,
        },
        limit: {
          mode: "delete",
          value: isMobile ? 24 : 75,
        },
      },
      color: {
        value: "#000000",
      },
      shape: {
        type: "circle",
      },
      opacity: {
        value: { min: 0.1, max: 0.5 },
      },
      size: {
        value: { min: 0.1, max: 6 },
      },
      links: {
        enable: true,
        distance: isMobile ? 125 : 150,
        color: "#000000",
        opacity: 0.4,
        width: 3,
      },
      move: {
        enable: true,
        speed: 1.0,
        direction: "none",
        random: false,
        straight: false,
        outModes: "out",
      },
    },
    interactivity: {
      detectsOn: "window",
      events: {
        onHover: {
          enable: !isMobile,
          mode: "grab",
        },
        onClick: {
          enable: false,
          mode: "push",
        },
      },
      modes: {
        grab: {
          distance: 195,
          links: {
            opacity: 1,
          },
        },
      },
    },
    detectRetina: !isMobile,
  });

  let engineLoaded = false;
  let particleContainer: Container | undefined;

  async function initParticles() {
    const container = document.getElementById("particles-js");
    if (!container || container.dataset["initialized"]) return;
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      isConstrainedConnection()
    ) {
      return;
    }
    container.dataset["initialized"] = "true";

    try {
      const isMobile = window.innerWidth < 640;
      const [
        { tsParticles },
        { loadBasic },
        { loadInteractivityPlugin },
        { loadParticlesLinksInteraction },
        grabModule,
      ] = await Promise.all([
        import("@tsparticles/engine"),
        import("@tsparticles/basic"),
        import("@tsparticles/plugin-interactivity"),
        import("@tsparticles/interaction-particles-links"),
        !isMobile
          ? import("@tsparticles/interaction-external-grab")
          : Promise.resolve(null),
      ]);

      await yieldToMain();
      if (pageUnloading || !container.isConnected) {
        delete container.dataset["initialized"];
        return;
      }

      if (!engineLoaded) {
        await loadBasic(tsParticles);
        await yieldToMain();
        await tsParticles.pluginManager.register(async (e) => {
          await loadInteractivityPlugin(e);
          await loadParticlesLinksInteraction(e);
          if (grabModule) {
            await grabModule.loadExternalGrabInteraction(e);
          }
        });
        engineLoaded = true;
        await yieldToMain();
      }

      if (pageUnloading || !container.isConnected) {
        delete container.dataset["initialized"];
        return;
      }

      const c = await tsParticles.load({
        id: "particles-js",
        options: getParticlesConfig(isMobile),
      });
      if (!container.isConnected || pageUnloading) {
        c?.destroy();
        delete container.dataset["initialized"];
        return;
      }
      particleContainer = c;
    } catch (err) {
      delete container.dataset["initialized"];
      console.warn("tsParticles initialization error:", err);
    }
  }

  let activeDownloadController: AbortController | null = null;
  let pageUnloading = false;
  let scheduleCleanup: (() => void) | undefined;

  function initResume() {
    const resumeBtn = document.getElementById(
      "download-resume-btn",
    ) as HTMLButtonElement | null;
    const resumeText = document.getElementById("download-resume-text");
    const resumeStatus = document.getElementById("resume-status");
    const resumeError = document.getElementById("resume-error");
    const resumeErrorMsg = document.getElementById("resume-error-msg");
    const resumeRetryBtn = document.getElementById("resume-retry-btn");
    if (!resumeBtn || resumeBtn.dataset["initialized"]) return;
    resumeBtn.dataset["initialized"] = "true";

    const showResumeError = (message: string) => {
      if (resumeErrorMsg) resumeErrorMsg.textContent = message;
      if (resumeError) resumeError.hidden = false;
      if (resumeStatus) resumeStatus.textContent = message;
    };

    const clearResumeError = () => {
      if (resumeError) resumeError.hidden = true;
      if (resumeErrorMsg) resumeErrorMsg.textContent = "";
    };

    const startDownload = async () => {
      const resumeUrl = resumeBtn.dataset["resumeUrl"];
      if (
        !resumeUrl ||
        resumeBtn.disabled ||
        resumeBtn.getAttribute("aria-busy") === "true"
      ) {
        return;
      }

      clearResumeError();

      if (typeof navigator !== "undefined" && !navigator.onLine) {
        showResumeError(
          "You appear to be offline. Reconnect and try again, or open the direct PDF link when online.",
        );
        return;
      }

      const originalText = resumeText?.textContent || "Download Resume";
      resumeBtn.disabled = true;
      resumeBtn.setAttribute("aria-busy", "true");
      if (resumeText) resumeText.textContent = "Downloading...";
      if (resumeStatus) {
        resumeStatus.textContent = "";
        resumeStatus.textContent = "Preparing resume download...";
      }

      activeDownloadController?.abort();
      const controller = new AbortController();
      activeDownloadController = controller;
      let timedOut = false;
      const timeoutId = window.setTimeout(() => {
        timedOut = true;
        controller.abort();
      }, 12000);

      try {
        const res = await fetch(resumeUrl, { signal: controller.signal });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const contentType = res.headers.get("content-type") || "";
        if (contentType.includes("text/html")) {
          throw new Error("Unexpected HTML response instead of PDF");
        }
        const blob = await res.blob();
        if (blob.size === 0) {
          throw new Error("Received empty file");
        }
        const blobUrl = window.URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = blobUrl;
        link.download = "AjmalBasheer-Resume.pdf";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.setTimeout(() => window.URL.revokeObjectURL(blobUrl), 1500);
        if (resumeStatus) {
          resumeStatus.textContent = "Resume downloaded successfully.";
        }
      } catch (err) {
        if (pageUnloading && controller.signal.aborted && !timedOut) {
          return;
        }
        if (typeof navigator !== "undefined" && !navigator.onLine) {
          showResumeError(
            "Connection lost while downloading. Reconnect to retry or open the PDF link directly.",
          );
        } else if (timedOut) {
          showResumeError(
            "Download timed out after 12s on a slow connection. Try again or open the PDF directly.",
          );
        } else {
          const detail =
            err instanceof Error && err.message ? ` (${err.message})` : "";
          showResumeError(
            `Could not download resume directly${detail}. Try again or open the PDF directly.`,
          );
        }
      } finally {
        window.clearTimeout(timeoutId);
        if (activeDownloadController === controller) {
          activeDownloadController = null;
        }
        if (resumeBtn.isConnected) {
          resumeBtn.disabled = false;
          resumeBtn.removeAttribute("aria-busy");
          if (resumeText) resumeText.textContent = originalText;
        }
      }
    };

    resumeBtn.addEventListener("click", () => {
      void startDownload();
    });
    resumeRetryBtn?.addEventListener("click", () => {
      void startDownload();
    });
  }

  const scheduleParticles = () => {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      isConstrainedConnection()
    ) {
      return;
    }
    scheduleCleanup?.();

    let scheduled = false;
    let idleId: number | undefined;
    let idleTimer: number | undefined;

    const cleanupTriggers = () => {
      window.removeEventListener("pointermove", start);
      window.removeEventListener("touchstart", start);
      window.removeEventListener("scroll", start);
      window.removeEventListener("load", triggerIdle);
      if (
        idleId !== undefined &&
        typeof window.cancelIdleCallback === "function"
      ) {
        window.cancelIdleCallback(idleId);
      }
      if (idleTimer !== undefined) {
        window.clearTimeout(idleTimer);
      }
    };

    const start = () => {
      if (scheduled || pageUnloading) return;
      scheduled = true;
      cleanupTriggers();
      void initParticles();
    };

    const triggerIdle = () => {
      if (scheduled || pageUnloading) return;
      if (typeof window.requestIdleCallback === "function") {
        idleId = window.requestIdleCallback(start, { timeout: 4000 });
      } else {
        idleTimer = window.setTimeout(start, 2500);
      }
    };

    scheduleCleanup = cleanupTriggers;

    window.addEventListener("pointermove", start, {
      once: true,
      passive: true,
    });
    window.addEventListener("touchstart", start, { once: true, passive: true });
    window.addEventListener("scroll", start, { once: true, passive: true });

    if (document.readyState === "complete") {
      triggerIdle();
    } else {
      window.addEventListener("load", triggerIdle, { once: true });
    }
  };

  const boot = () => {
    pageUnloading = false;
    initResume();
    scheduleParticles();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  const cleanup = () => {
    pageUnloading = true;
    scheduleCleanup?.();
    scheduleCleanup = undefined;
    activeDownloadController?.abort();
    activeDownloadController = null;
    particleContainer?.destroy();
    particleContainer = undefined;
    const container = document.getElementById("particles-js");
    if (container) delete container.dataset["initialized"];
  };

  window.addEventListener("pagehide", cleanup);
  window.addEventListener("pageshow", (event) => {
    pageUnloading = false;
    if (!event.persisted) return;
    initResume();
    const container = document.getElementById("particles-js");
    if (container) delete container.dataset["initialized"];
    if (document.readyState === "complete") {
      void initParticles();
    } else {
      window.addEventListener("load", () => void initParticles(), {
        once: true,
      });
    }
  });
</script>
