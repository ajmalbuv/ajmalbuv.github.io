---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  screenshots: readonly ImageMetadata[];
}

const { title, screenshots } = Astro.props;
if (!screenshots || screenshots.length === 0) {
  return;
}
---

<section class="mb-12 sm:mb-16" id="project-gallery-section">
  <div class="flex items-center justify-between mb-4 sm:mb-6">
    <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
      Interface Previews
    </h2>
    {screenshots.length > 1 && (
      <span
        id="gallery-counter"
        class="font-mono text-xs text-neutral-400 bg-neutral-900/90 px-3 py-1 rounded-full border border-neutral-800 shadow-inner"
      >
        1 / {screenshots.length}
      </span>
    )}
  </div>

  <div class="gallery-root relative bg-surface-card border border-neutral-800/90 rounded-2xl overflow-hidden shadow-2xl">
    <!-- Main Display Viewport (Native CSS Scroll-Snap) -->
    <div class="relative aspect-video sm:aspect-16/10 bg-neutral-950 overflow-hidden group">
      <div
        class="gallery-viewport flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth overscroll-x-contain scrollbar-none [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset"
        role="region"
        aria-label="Interface previews carousel"
        tabindex="0"
      >
        {screenshots.map((shot, idx) => (
          <div
            class="gallery-slide shrink-0 w-full h-full snap-center flex items-center justify-center p-1 sm:p-2 select-none"
            data-slide-index={idx}
          >
            <Image
              src={shot}
              alt={`${title} - Preview ${idx + 1}`}
              class="w-full h-full object-contain cursor-zoom-in"
              loading={idx === 0 ? 'eager' : 'lazy'}
              widths={[640, 960, 1280, 1920]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1152px"
              data-zoom-src={shot.src}
            />
          </div>
        ))}
      </div>

      <!-- Overlay Prev/Next Arrows -->
      {screenshots.length > 1 && (
        <>
          <button
            type="button"
            class="gallery-prev-btn absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 min-w-11 min-h-11 p-2 sm:p-2.5 rounded-full bg-black/70 hover:bg-accent text-white hover:text-black backdrop-blur-md border border-white/10 transition-all active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent opacity-80 sm:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 cursor-pointer flex items-center justify-center"
            aria-label="Previous preview"
          >
            <Icon name="mdi:chevron-left" class="w-5 h-5 sm:w-6 sm:h-6" aria-hidden="true" />
          </button>

          <button
            type="button"
            class="gallery-next-btn absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 min-w-11 min-h-11 p-2 sm:p-2.5 rounded-full bg-black/70 hover:bg-accent text-white hover:text-black backdrop-blur-md border border-white/10 transition-all active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent opacity-80 sm:opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 cursor-pointer flex items-center justify-center"
            aria-label="Next preview"
          >
            <Icon name="mdi:chevron-right" class="w-5 h-5 sm:w-6 sm:h-6" aria-hidden="true" />
          </button>
        </>
      )}

      <!-- Fullscreen zoom prompt button -->
      <button
        type="button"
        class="gallery-expand-btn absolute bottom-3 right-3 z-20 inline-flex items-center justify-center gap-1.5 min-h-11 px-3.5 py-2 rounded-lg bg-black/80 hover:bg-accent text-neutral-300 hover:text-black font-mono text-xs backdrop-blur-md border border-white/10 transition-all active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent cursor-pointer"
        aria-label="Open fullscreen preview"
      >
        <Icon name="mdi:arrow-expand" class="w-4 h-4" aria-hidden="true" />
        <span class="hidden sm:inline">Fullscreen</span>
      </button>
    </div>

    <!-- Thumbnail Strip -->
    {screenshots.length > 1 && (
      <div class="p-3 sm:p-4 bg-neutral-900/95 border-t border-neutral-800">
        <div class="gallery-thumbs flex gap-2 sm:gap-3 overflow-x-auto pb-1 scrollbar-thin scrollbar-neutral-700">
          {screenshots.map((shot, idx) => (
            <button
              type="button"
              class:list={[
                'gallery-thumb shrink-0 relative w-16 sm:w-20 md:w-24 aspect-video rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-accent',
                idx === 0
                  ? 'border-accent ring-1 ring-accent/50 scale-105'
                  : 'border-neutral-800 opacity-60 hover:opacity-100 hover:border-neutral-600',
              ]}
              data-thumb-index={idx}
              aria-label={`View screenshot ${idx + 1}`}
              aria-current={idx === 0 ? 'true' : 'false'}
            >
              <Image
                src={shot}
                alt={`Thumbnail ${idx + 1}`}
                class="w-full h-full object-cover"
                widths={[96, 192]}
                loading="lazy"
              />
            </button>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Native Lightbox Dialog -->
  <dialog
    id="gallery-lightbox"
    closedby="any"
    aria-label={`${title} interface preview lightbox`}
    class="backdrop:bg-black/95 backdrop:backdrop-blur-sm bg-transparent p-0 m-auto max-w-[95vw] max-h-[95vh] outline-none border-none text-white rounded-2xl overflow-hidden shadow-2xl"
  >
    <div class="relative flex flex-col items-center justify-center p-2 sm:p-6">
      <button
        id="lightbox-close-btn"
        type="button"
        class="absolute top-4 right-4 z-50 min-w-11 min-h-11 p-2.5 rounded-full bg-black/80 hover:bg-accent text-white hover:text-black border border-white/10 transition-colors active:scale-95 cursor-pointer flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="Close fullscreen view"
      >
        <Icon name="mdi:close" class="w-6 h-6" aria-hidden="true" />
      </button>

      {screenshots.length > 1 && (
        <>
          <button
            id="lightbox-prev-btn"
            type="button"
            class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-50 min-w-11 min-h-11 p-2 sm:p-2.5 rounded-full bg-black/80 hover:bg-accent text-white hover:text-black border border-white/10 transition-colors active:scale-95 cursor-pointer flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label="Previous image"
          >
            <Icon name="mdi:chevron-left" class="w-6 h-6" aria-hidden="true" />
          </button>

          <button
            id="lightbox-next-btn"
            type="button"
            class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-50 min-w-11 min-h-11 p-2 sm:p-2.5 rounded-full bg-black/80 hover:bg-accent text-white hover:text-black border border-white/10 transition-colors active:scale-95 cursor-pointer flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label="Next image"
          >
            <Icon name="mdi:chevron-right" class="w-6 h-6" aria-hidden="true" />
          </button>
        </>
      )}

      <img
        id="lightbox-img"
        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
        alt={`${title} - Fullscreen preview`}
        class="max-w-[92vw] max-h-[85vh] object-contain rounded-xl shadow-2xl transition-opacity duration-150"
      />

      <div class="mt-3 flex items-center justify-between w-full max-w-md px-4 font-mono text-xs text-neutral-400">
        <span id="lightbox-counter" aria-live="polite" aria-atomic="true">1 / {screenshots.length}</span>
        <span class="hidden sm:inline">Press ESC to close</span>
      </div>
    </div>
  </dialog>
</section>

<style>
  dialog#gallery-lightbox {
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), overlay 0.2s allow-discrete, display 0.2s allow-discrete;
  }

  dialog#gallery-lightbox[open] {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    dialog#gallery-lightbox[open] {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  dialog#gallery-lightbox::backdrop {
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), overlay 0.2s allow-discrete, display 0.2s allow-discrete;
  }

  dialog#gallery-lightbox[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog#gallery-lightbox[open]::backdrop {
      opacity: 0;
    }
  }
</style>

<script>
  let cleanupGallery: (() => void) | undefined;

  function setupGallery() {
    cleanupGallery?.();

    const root = document.querySelector<HTMLElement>('.gallery-root');
    if (!root) return;
    const viewport = root.querySelector<HTMLElement>('.gallery-viewport');
    if (!viewport) return;

    const slides = Array.from(
      viewport.querySelectorAll<HTMLElement>('.gallery-slide'),
    );
    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.gallery-thumb'),
    );
    const counter = document.getElementById('gallery-counter');
    const prevBtn = root.querySelector<HTMLButtonElement>('.gallery-prev-btn');
    const nextBtn = root.querySelector<HTMLButtonElement>('.gallery-next-btn');
    const expandBtn = root.querySelector<HTMLButtonElement>(
      '.gallery-expand-btn',
    );
    const lightbox = document.getElementById(
      'gallery-lightbox',
    ) as HTMLDialogElement | null;
    const lightboxImg = document.getElementById(
      'lightbox-img',
    ) as HTMLImageElement | null;
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxClose = document.getElementById('lightbox-close-btn');
    const lightboxPrev = document.getElementById('lightbox-prev-btn');
    const lightboxNext = document.getElementById('lightbox-next-btn');

    let activeIndex = 0;
    const total = slides.length;
    if (total === 0) return;

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    function updateActiveState(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;

      thumbs.forEach((thumb, idx) => {
        const isActive = idx === activeIndex;
        thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
        if (isActive) {
          thumb.classList.remove('border-neutral-800', 'opacity-60');
          thumb.classList.add(
            'border-accent',
            'ring-1',
            'ring-accent/50',
            'scale-105',
            'opacity-100',
          );
          thumb.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'nearest',
            inline: 'center',
          });
        } else {
          thumb.classList.remove(
            'border-accent',
            'ring-1',
            'ring-accent/50',
            'scale-105',
            'opacity-100',
          );
          thumb.classList.add('border-neutral-800', 'opacity-60');
        }
      });

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${total}`;
      }

      if (lightbox && lightbox.open && lightboxImg) {
        const activeImg = slides[activeIndex]?.querySelector('img');
        const zoomSrc = activeImg?.dataset['zoomSrc'] || activeImg?.src;
        if (zoomSrc) lightboxImg.src = zoomSrc;
        if (activeImg?.alt) lightboxImg.alt = activeImg.alt;
        if (lightboxCounter) {
          lightboxCounter.textContent = `${activeIndex + 1} / ${total}`;
        }
      }
    }

    function scrollToSlide(index: number) {
      const targetIndex = (index + total) % total;
      slides[targetIndex]?.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'start',
      });
    }

    // IntersectionObserver to observe which slide is snapped into view
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = Number.parseInt(
              (entry.target as HTMLElement).dataset['slideIndex'] || '0',
              10,
            );
            updateActiveState(idx);
          }
        }
      },
      {
        root: viewport,
        threshold: 0.6,
      },
    );

    slides.forEach((slide) => observer.observe(slide));

    const onPrev = () => {
      viewport.scrollBy({
        left: -viewport.clientWidth,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    };
    const onNext = () => {
      viewport.scrollBy({
        left: viewport.clientWidth,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    };

    prevBtn?.addEventListener('click', onPrev);
    nextBtn?.addEventListener('click', onNext);

    const onThumbClicks: Array<{
      btn: HTMLButtonElement;
      handler: () => void;
    }> = [];
    thumbs.forEach((thumb) => {
      const idx = Number.parseInt(thumb.dataset['thumbIndex'] || '0', 10);
      const handler = () => scrollToSlide(idx);
      thumb.addEventListener('click', handler);
      onThumbClicks.push({ btn: thumb, handler });
    });

    // Lightbox modal logic
    let lastActiveElement: HTMLElement | null = null;

    function openLightbox() {
      if (!lightbox || !lightboxImg) return;
      const activeElement = document.activeElement;
      lastActiveElement =
        activeElement instanceof HTMLElement && activeElement !== document.body
          ? activeElement
          : (expandBtn ?? thumbs[activeIndex] ?? viewport ?? null);
      const activeImg = slides[activeIndex]?.querySelector('img');
      const zoomSrc = activeImg?.dataset['zoomSrc'] || activeImg?.src;
      if (!zoomSrc) return;
      lightboxImg.src = zoomSrc;
      if (activeImg?.alt) lightboxImg.alt = activeImg.alt;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${activeIndex + 1} / ${total}`;
      }
      lightbox.showModal();
    }

    expandBtn?.addEventListener('click', openLightbox);
    const onSlideClicks: Array<{ img: Element; handler: () => void }> = [];
    slides.forEach((slide) => {
      const img = slide.querySelector('img');
      if (img) {
        img.addEventListener('click', openLightbox);
        onSlideClicks.push({ img, handler: openLightbox });
      }
    });

    const onCloseLightbox = () => lightbox?.close();
    lightboxClose?.addEventListener('click', onCloseLightbox);

    const onLightboxPrev = () => scrollToSlide(activeIndex - 1);
    const onLightboxNext = () => scrollToSlide(activeIndex + 1);
    lightboxPrev?.addEventListener('click', onLightboxPrev);
    lightboxNext?.addEventListener('click', onLightboxNext);

    const onDialogClose = () => {
      if (lightboxImg) {
        lightboxImg.src =
          "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E";
      }
      const target = lastActiveElement;
      lastActiveElement = null;
      if (target?.isConnected) {
        target.focus();
      } else {
        expandBtn?.focus();
      }
    };
    lightbox?.addEventListener('close', onDialogClose);

    // Close on backdrop click (click directly on native dialog element)
    const onBackdropClick = (e: MouseEvent) => {
      if (lightbox && e.target === lightbox) {
        lightbox.close();
      }
    };
    lightbox?.addEventListener('click', onBackdropClick);

    // Touch swipe gesture support for mobile fullscreen lightbox
    let touchStartX = 0;
    let touchStartY = 0;

    const onTouchStart = (e: TouchEvent) => {
      const touch = e.changedTouches[0];
      if (touch) {
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      }
    };

    const onTouchEnd = (e: TouchEvent) => {
      const touch = e.changedTouches[0];
      if (!touch) return;
      const diffX = touch.clientX - touchStartX;
      const diffY = touch.clientY - touchStartY;
      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY) * 1.5) {
        if (diffX < 0) {
          scrollToSlide(activeIndex + 1);
        } else {
          scrollToSlide(activeIndex - 1);
        }
      }
    };

    lightbox?.addEventListener('touchstart', onTouchStart, { passive: true });
    lightbox?.addEventListener('touchend', onTouchEnd, { passive: true });

    // Keyboard arrow navigation
    const onKeyDown = (e: KeyboardEvent) => {
      if (lightbox && lightbox.open) {
        if (e.key === 'ArrowRight') scrollToSlide(activeIndex + 1);
        if (e.key === 'ArrowLeft') scrollToSlide(activeIndex - 1);
      }
    };
    window.addEventListener('keydown', onKeyDown);

    cleanupGallery = () => {
      observer.disconnect();
      prevBtn?.removeEventListener('click', onPrev);
      nextBtn?.removeEventListener('click', onNext);
      expandBtn?.removeEventListener('click', openLightbox);
      lightboxClose?.removeEventListener('click', onCloseLightbox);
      lightboxPrev?.removeEventListener('click', onLightboxPrev);
      lightboxNext?.removeEventListener('click', onLightboxNext);
      lightbox?.removeEventListener('close', onDialogClose);
      lightbox?.removeEventListener('click', onBackdropClick);
      lightbox?.removeEventListener('touchstart', onTouchStart);
      lightbox?.removeEventListener('touchend', onTouchEnd);
      window.removeEventListener('keydown', onKeyDown);
      onThumbClicks.forEach(({ btn, handler }) =>
        btn.removeEventListener('click', handler),
      );
      onSlideClicks.forEach(({ img, handler }) =>
        img.removeEventListener('click', handler),
      );
    };
  }

  document.addEventListener('DOMContentLoaded', setupGallery);
  window.addEventListener('pagehide', () => {
    cleanupGallery?.();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) setupGallery();
  });
</script>
