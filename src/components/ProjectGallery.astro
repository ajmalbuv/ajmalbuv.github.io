---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  screenshots: readonly ImageMetadata[];
}

const { title, screenshots } = Astro.props;
if (!screenshots || screenshots.length === 0) {
  return;
}
---

<section class="mb-12 sm:mb-16" id="project-gallery-section">
  <div class="flex items-baseline justify-between mb-4 sm:mb-6">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
        Visual Showcase
      </span>
      <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">
        Interface Previews
      </h2>
    </div>
    <span
      id="gallery-counter"
      class="font-mono text-xs text-neutral-400 bg-neutral-900 px-2.5 py-1 rounded-full border border-neutral-800"
    >
      1 / {screenshots.length}
    </span>
  </div>

  <div class="gallery-root relative bg-[#121212] border border-neutral-800/90 rounded-2xl overflow-hidden shadow-2xl">
    <!-- Main Display Viewport (Native CSS Scroll-Snap) -->
    <div class="relative aspect-video sm:aspect-16/10 bg-neutral-950 overflow-hidden group">
      <div
        class="gallery-viewport flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth overscroll-x-contain scrollbar-none [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        role="region"
        aria-label="Interface previews carousel"
        tabindex="0"
      >
        {screenshots.map((shot, idx) => (
          <div
            class="gallery-slide shrink-0 w-full h-full snap-center flex items-center justify-center p-1 sm:p-2 select-none"
            data-slide-index={idx}
          >
            <Image
              src={shot}
              alt={`${title} - Preview ${idx + 1}`}
              class="w-full h-full object-contain cursor-zoom-in"
              loading={idx === 0 ? 'eager' : 'lazy'}
              widths={[640, 960, 1280, 1920]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1152px"
              data-zoom-src={shot.src}
            />
          </div>
        ))}
      </div>

      <!-- Overlay Prev/Next Arrows -->
      <button
        type="button"
        class="gallery-prev-btn absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 p-2 sm:p-2.5 rounded-full bg-black/70 hover:bg-[#fc7a00] text-white hover:text-black backdrop-blur-md border border-white/10 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] opacity-80 sm:opacity-0 group-hover:opacity-100 cursor-pointer"
        aria-label="Previous preview"
      >
        <Icon name="mdi:chevron-left" class="w-5 h-5 sm:w-6 sm:h-6" />
      </button>

      <button
        type="button"
        class="gallery-next-btn absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 p-2 sm:p-2.5 rounded-full bg-black/70 hover:bg-[#fc7a00] text-white hover:text-black backdrop-blur-md border border-white/10 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] opacity-80 sm:opacity-0 group-hover:opacity-100 cursor-pointer"
        aria-label="Next preview"
      >
        <Icon name="mdi:chevron-right" class="w-5 h-5 sm:w-6 sm:h-6" />
      </button>

      <!-- Fullscreen zoom prompt button -->
      <button
        type="button"
        class="gallery-expand-btn absolute bottom-3 right-3 z-20 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black/80 hover:bg-[#fc7a00] text-neutral-300 hover:text-black font-mono text-xs backdrop-blur-md border border-white/10 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] cursor-pointer"
        aria-label="Open fullscreen preview"
      >
        <Icon name="mdi:arrow-expand" class="w-4 h-4" />
        <span class="hidden sm:inline">Fullscreen</span>
      </button>
    </div>

    <!-- Thumbnail Strip -->
    <div class="p-3 sm:p-4 bg-neutral-900/95 border-t border-neutral-800">
      <div class="gallery-thumbs flex gap-2 sm:gap-3 overflow-x-auto pb-1 scrollbar-thin scrollbar-neutral-700">
        {screenshots.map((shot, idx) => (
          <button
            type="button"
            class:list={[
              'gallery-thumb shrink-0 relative w-16 sm:w-20 md:w-24 aspect-video rounded-lg overflow-hidden border-2 transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00]',
              idx === 0
                ? 'border-[#fc7a00] ring-1 ring-[#fc7a00]/50 scale-105'
                : 'border-neutral-800 opacity-60 hover:opacity-100 hover:border-neutral-600',
            ]}
            data-thumb-index={idx}
            aria-label={`View screenshot ${idx + 1}`}
          >
            <Image
              src={shot}
              alt={`Thumbnail ${idx + 1}`}
              class="w-full h-full object-cover"
              widths={[96, 192]}
              loading="lazy"
            />
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Native Lightbox Dialog -->
  <dialog
    id="gallery-lightbox"
    class="backdrop:bg-black/90 bg-transparent p-0 m-auto max-w-[95vw] max-h-[95vh] outline-none border-none text-white rounded-2xl overflow-hidden"
  >
    <div class="relative flex flex-col items-center justify-center p-2 sm:p-6">
      <button
        id="lightbox-close-btn"
        type="button"
        class="absolute top-4 right-4 z-50 p-2 rounded-full bg-black/80 hover:bg-[#fc7a00] text-white hover:text-black border border-white/10 transition-colors cursor-pointer"
        aria-label="Close fullscreen view"
      >
        <Icon name="mdi:close" class="w-6 h-6" />
      </button>

      <img
        id="lightbox-img"
        src=""
        alt="Fullscreen interface preview"
        class="max-w-[92vw] max-h-[85vh] object-contain rounded-xl shadow-2xl"
      />

      <div class="mt-3 flex items-center justify-between w-full max-w-md px-4 font-mono text-xs text-neutral-400">
        <span id="lightbox-counter">1 / {screenshots.length}</span>
        <span>Press ESC to close</span>
      </div>
    </div>
  </dialog>
</section>

<script>
  let cleanupGallery: (() => void) | undefined;

  function setupGallery() {
    cleanupGallery?.();

    const root = document.querySelector<HTMLElement>('.gallery-root');
    const viewport = root?.querySelector<HTMLElement>('.gallery-viewport');
    if (!root || !viewport) return;

    const slides = Array.from(
      viewport.querySelectorAll<HTMLElement>('.gallery-slide'),
    );
    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.gallery-thumb'),
    );
    const counter = document.getElementById('gallery-counter');
    const prevBtn = root.querySelector<HTMLButtonElement>('.gallery-prev-btn');
    const nextBtn = root.querySelector<HTMLButtonElement>('.gallery-next-btn');
    const expandBtn = root.querySelector<HTMLButtonElement>(
      '.gallery-expand-btn',
    );
    const lightbox = document.getElementById(
      'gallery-lightbox',
    ) as HTMLDialogElement | null;
    const lightboxImg = document.getElementById(
      'lightbox-img',
    ) as HTMLImageElement | null;
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxClose = document.getElementById('lightbox-close-btn');

    let activeIndex = 0;
    const total = slides.length;
    if (total === 0) return;

    function updateActiveState(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;

      thumbs.forEach((thumb, idx) => {
        if (idx === activeIndex) {
          thumb.classList.remove('border-neutral-800', 'opacity-60');
          thumb.classList.add(
            'border-[#fc7a00]',
            'ring-1',
            'ring-[#fc7a00]/50',
            'scale-105',
            'opacity-100',
          );
          thumb.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center',
          });
        } else {
          thumb.classList.remove(
            'border-[#fc7a00]',
            'ring-1',
            'ring-[#fc7a00]/50',
            'scale-105',
            'opacity-100',
          );
          thumb.classList.add('border-neutral-800', 'opacity-60');
        }
      });

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${total}`;
      }

      if (lightbox && lightbox.open && lightboxImg) {
        const activeImg = slides[activeIndex]?.querySelector('img');
        const zoomSrc = activeImg?.dataset['zoomSrc'] || activeImg?.src;
        if (zoomSrc) lightboxImg.src = zoomSrc;
        if (lightboxCounter) {
          lightboxCounter.textContent = `${activeIndex + 1} / ${total}`;
        }
      }
    }

    function scrollToSlide(index: number) {
      const targetIndex = (index + total) % total;
      slides[targetIndex]?.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'start',
      });
    }

    // IntersectionObserver to observe which slide is snapped into view
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = Number.parseInt(
              (entry.target as HTMLElement).dataset['slideIndex'] || '0',
              10,
            );
            updateActiveState(idx);
          }
        }
      },
      {
        root: viewport,
        threshold: 0.6,
      },
    );

    slides.forEach((slide) => observer.observe(slide));

    const onPrev = () => {
      viewport.scrollBy({ left: -viewport.clientWidth, behavior: 'smooth' });
    };
    const onNext = () => {
      viewport.scrollBy({ left: viewport.clientWidth, behavior: 'smooth' });
    };

    prevBtn?.addEventListener('click', onPrev);
    nextBtn?.addEventListener('click', onNext);

    const onThumbClicks: Array<{
      btn: HTMLButtonElement;
      handler: () => void;
    }> = [];
    thumbs.forEach((thumb) => {
      const idx = Number.parseInt(thumb.dataset['thumbIndex'] || '0', 10);
      const handler = () => scrollToSlide(idx);
      thumb.addEventListener('click', handler);
      onThumbClicks.push({ btn: thumb, handler });
    });

    // Lightbox modal logic
    function openLightbox() {
      if (!lightbox || !lightboxImg) return;
      const activeImg = slides[activeIndex]?.querySelector('img');
      const zoomSrc = activeImg?.dataset['zoomSrc'] || activeImg?.src;
      if (!zoomSrc) return;
      lightboxImg.src = zoomSrc;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${activeIndex + 1} / ${total}`;
      }
      lightbox.showModal();
    }

    expandBtn?.addEventListener('click', openLightbox);
    const onSlideClicks: Array<{ img: Element; handler: () => void }> = [];
    slides.forEach((slide) => {
      const img = slide.querySelector('img');
      if (img) {
        img.addEventListener('click', openLightbox);
        onSlideClicks.push({ img, handler: openLightbox });
      }
    });

    const onCloseLightbox = () => lightbox?.close();
    lightboxClose?.addEventListener('click', onCloseLightbox);

    const onLightboxBackdrop = (e: MouseEvent) => {
      if (e.target === lightbox) lightbox?.close();
    };
    lightbox?.addEventListener('click', onLightboxBackdrop);

    // Keyboard arrow navigation
    const onKeyDown = (e: KeyboardEvent) => {
      if (lightbox && lightbox.open) {
        if (e.key === 'ArrowRight') scrollToSlide(activeIndex + 1);
        if (e.key === 'ArrowLeft') scrollToSlide(activeIndex - 1);
      }
    };
    window.addEventListener('keydown', onKeyDown);

    cleanupGallery = () => {
      observer.disconnect();
      prevBtn?.removeEventListener('click', onPrev);
      nextBtn?.removeEventListener('click', onNext);
      expandBtn?.removeEventListener('click', openLightbox);
      lightboxClose?.removeEventListener('click', onCloseLightbox);
      lightbox?.removeEventListener('click', onLightboxBackdrop);
      window.removeEventListener('keydown', onKeyDown);
      onThumbClicks.forEach(({ btn, handler }) =>
        btn.removeEventListener('click', handler),
      );
      onSlideClicks.forEach(({ img, handler }) =>
        img.removeEventListener('click', handler),
      );
    };
  }

  document.addEventListener('DOMContentLoaded', setupGallery);
  document.addEventListener('astro:page-load', setupGallery);
  document.addEventListener('astro:before-swap', () => {
    cleanupGallery?.();
  });
</script>
