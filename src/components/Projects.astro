---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';
import { projectPath } from '../utils/url';

const { projects } = siteData;
---

<section
  id="work"
  class="py-8 sm:py-10 px-3.5 sm:px-6 lg:px-8 max-w-5xl 2xl:max-w-6xl mx-auto"
>
  <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-accent font-bold">
        Selected Engineering
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-1">
        Featured Work
      </h2>
    </div>
    <p class="text-sm text-neutral-400 max-w-md">
      Production applications and systems built with high performance, clean
      architecture, and responsive UX.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
    {projects.map((project) => (
      <article class="relative z-10 min-w-0 bg-surface-card border border-neutral-800 rounded-2xl overflow-hidden flex flex-col hover:border-accent/50 hover:shadow-xl transition-[border-color,box-shadow,transform] duration-300 group motion-safe:hover:-translate-y-1 motion-reduce:transition-colors">
        <div class="block overflow-hidden relative aspect-video bg-neutral-900">
          <Image
            src={project.coverImage}
            alt={`${project.title} cover image`}
            widths={[380, 480, 640, 960, 1280]}
            sizes="(min-width: 1536px) 528px, (min-width: 1024px) 464px, (min-width: 768px) 50vw, 100vw"
            format="webp"
            class="w-full h-full object-cover transition-[transform,scale] duration-500 motion-safe:group-hover:scale-105 motion-reduce:transition-none"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-surface-card via-transparent to-transparent opacity-80" />
        </div>
        <div class="p-4 sm:p-6 flex-1 min-w-0 flex flex-col justify-between">
          <div class="min-w-0">
            <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-accent transition-colors mb-2 wrap-break-word">
              <a
                href={projectPath(project.slug)}
                class="focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded after:absolute after:inset-0 after:z-10"
              >
                {project.title}
              </a>
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-5 wrap-break-word">
              {project.summary}
            </p>
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap gap-1.5 mb-5 relative z-20">
              {project.techstack.map((tech) => (
                <span class="max-w-full wrap-break-word px-2 py-0.5 sm:px-2.5 sm:py-1 text-[11px] sm:text-xs font-mono font-medium rounded bg-neutral-900 text-neutral-300 border border-neutral-800">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-neutral-800/80 relative z-20 gap-2">
              <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-neutral-300 group-hover:text-accent transition-colors">
                <span>View Project</span>
                <Icon
                  name="mdi:arrow-right"
                  class="w-4 h-4 shrink-0 transition-transform motion-safe:group-hover:translate-x-1 rtl:rotate-180 rtl:motion-safe:group-hover:-translate-x-1 motion-reduce:transition-none"
                  aria-hidden="true"
                />
              </span>

              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                  class="text-neutral-400 hover:text-white transition-colors min-w-11 min-h-11 inline-flex items-center justify-center p-2 rounded-lg hover:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent shrink-0"
                >
                  <Icon name="mdi:github" class="w-5 h-5" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
