---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';

const { projects } = siteData;
---

<section
  id="work"
  class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 max-w-5xl 2xl:max-w-6xl mx-auto"
>
  <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
        Selected Engineering
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-1">
        Featured Work
      </h2>
    </div>
    <p class="text-sm text-neutral-400 max-w-md">
      Production applications and systems built with high performance, clean
      architecture, and responsive UX.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
    {projects.map((project) => (
      <article class="relative z-10 bg-[#121212] border border-neutral-800 rounded-2xl overflow-hidden flex flex-col hover:border-[#fc7a00]/50 hover:shadow-xl hover:shadow-[#fc7a00]/5 transition-all duration-300 group hover:-translate-y-1">
        <div class="block overflow-hidden relative aspect-video bg-neutral-900">
          <Image
            src={project.coverImage}
            alt={`${project.title} cover image`}
            widths={[380, 480, 640, 960, 1280]}
            sizes="(min-width: 1536px) 528px, (min-width: 1024px) 464px, (min-width: 768px) 50vw, 100vw"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#121212] via-transparent to-transparent opacity-80" />
        </div>
        <div class="p-4 sm:p-6 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-[#fc7a00] transition-colors mb-2">
              <a
                href={`/projects/${project.slug}`}
                class="focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded after:absolute after:inset-0 after:z-10"
              >
                {project.title}
              </a>
            </h3>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed mb-5">
              {project.summary}
            </p>
          </div>
          <div>
            <div class="flex flex-wrap gap-1.5 mb-5 relative z-20">
              {project.techstack.map((tech) => (
                <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 text-[11px] sm:text-xs font-mono font-medium rounded bg-neutral-900 text-neutral-300 border border-neutral-800">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-neutral-800/80 relative z-20">
              <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-neutral-300 group-hover:text-[#fc7a00] transition-colors">
                <span>View Project</span>
                <Icon
                  name="mdi:arrow-right"
                  class="w-4 h-4 transition-transform group-hover:translate-x-1"
                />
              </span>

              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${project.title} on GitHub`}
                  class="text-neutral-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-neutral-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00]"
                >
                  <Icon name="mdi:github" class="w-5 h-5" />
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
