---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';

const { projects } = siteData;
---

<section id="work" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
  <div class="mb-12 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
        Selected Engineering
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mt-1">
        Featured Work
      </h2>
    </div>
    <p class="text-sm text-neutral-400 max-w-md">
      Production applications and systems built with high performance, clean architecture, and responsive UX.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      projects.map((project) => (
        <article class="bg-[#121212] border border-neutral-800 rounded-2xl overflow-hidden flex flex-col hover:border-neutral-700 transition-all duration-300 group hover:-translate-y-1">
          <!-- Project Cover Image with Hover Zoom -->
          <a href={`/projects/${project.slug}`} class="block overflow-hidden relative aspect-video bg-neutral-900">
            <Image
              src={project.coverImage}
              alt={`${project.title} cover image`}
              width={640}
              height={360}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-[#121212] via-transparent to-transparent opacity-80" />
          </a>

          <!-- Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold text-white group-hover:text-[#fc7a00] transition-colors mb-2">
                <a href={`/projects/${project.slug}`} class="focus:outline-none focus-visible:ring-1 focus-visible:ring-[#fc7a00] rounded">
                  {project.title}
                </a>
              </h3>
              <p class="text-sm text-neutral-300 leading-relaxed mb-6">
                {project.summary}
              </p>
            </div>

            <!-- Techstack Badges & Detail CTA -->
            <div>
              <div class="flex flex-wrap gap-1.5 mb-6">
                {project.techstack.map((tech) => (
                  <span class="px-2.5 py-1 text-xs font-mono font-medium rounded bg-neutral-900 text-neutral-300 border border-neutral-800">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-neutral-800/80">
                <a
                  href={`/projects/${project.slug}`}
                  class="inline-flex items-center gap-1 text-sm font-semibold text-white hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#fc7a00] rounded"
                >
                  <span>Explore Case Study</span>
                  <Icon name="mdi:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </a>

                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`View ${project.title} on GitHub`}
                    class="text-neutral-400 hover:text-white transition-colors p-1"
                  >
                    <Icon name="mdi:github" class="w-5 h-5" />
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
