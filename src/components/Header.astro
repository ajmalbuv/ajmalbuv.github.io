---
import { Icon } from 'astro-icon/components';
---

<header class="top-0 sticky z-50 transition-all duration-300" id="main-header">
  <div class="flex justify-between items-center text-white lg:px-20">
    <div class="p-3">
      <h1 class="text-4xl lg:text-5xl font-semibold">Portfolio.</h1>
    </div>
    <nav
      class="fixed w-full top-16 bg-black/95 sm:bg-transparent sm:relative sm:top-0 sm:w-[50%] overflow-hidden sm:overflow-visible"
      id="sidebar"
    >
      <ul
        class="flex flex-col sm:flex-row justify-between items-center p-3 gap-4 sm:gap-0"
      >
        <li><a href="/">Home</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#skill">Skills</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="sm:hidden p-3">
      <button
        id="toggle-btn"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="sidebar"
        class="group focus:outline-none cursor-pointer"
      >
        <Icon name="mdi:menu" class="h-10 w-10 block group-aria-expanded:hidden" />
        <Icon name="mdi:close" class="h-10 w-10 hidden group-aria-expanded:block" />
      </button>
    </div>
  </div>
</header>

<style>
  header {
    background: linear-gradient(135deg, #43639c 0%, #412653 70%);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  /* Mobile drawer transition (handled entirely in CSS) */
  @media (max-width: 639px) {
    #sidebar {
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
    }
    #sidebar[data-open="true"] {
      max-height: 24rem;
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const toggleBtn = target.closest("#toggle-btn");
    if (toggleBtn) {
      const sidebar = document.getElementById("sidebar");
      const isOpen = sidebar?.getAttribute("data-open") === "true";
      const nextState = !isOpen;

      sidebar?.setAttribute("data-open", String(nextState));
      toggleBtn.setAttribute("aria-expanded", String(nextState));
      return;
    }

    if (target.closest("#sidebar a")) {
      const sidebar = document.getElementById("sidebar");
      const toggle = document.getElementById("toggle-btn");
      sidebar?.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>
