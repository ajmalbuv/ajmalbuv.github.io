---
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#0a0a0a]/85 border-b border-neutral-800/70 transition-all duration-300"
  id="main-header"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Monospace Name -->
    <a
      href="/#home"
      class="font-mono text-lg font-bold tracking-tight text-white hover:text-[#fc7a00] transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded"
    >
      <span>{siteData.personal.handle}</span>
      <span class="inline-block w-2 h-2 rounded-full bg-[#fc7a00] animate-pulse"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden sm:flex items-center gap-8 text-sm font-medium">
      <a
        href="/#home"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Home
      </a>
      <a
        href="/#about"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        About
      </a>
      <a
        href="/#work"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Work
      </a>
      <a
        href="/#skills"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Skills
      </a>
      <a
        href="/#contact"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Contact
      </a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <div class="sm:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="p-2 text-neutral-300 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded cursor-pointer"
      >
        <Icon name="mdi:menu" class="h-6 w-6 block group-data-[open=true]:hidden" id="menu-icon-open" />
        <Icon name="mdi:close" class="h-6 w-6 hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden bg-[#0a0a0a] border-b border-neutral-800 px-4 py-4 space-y-3 transition-all"
  >
    <a
      href="/#home"
      class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-2 px-3 rounded hover:bg-neutral-900 transition-colors"
    >
      Home
    </a>
    <a
      href="/#about"
      class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-2 px-3 rounded hover:bg-neutral-900 transition-colors"
    >
      About &amp; Experience
    </a>
    <a
      href="/#work"
      class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-2 px-3 rounded hover:bg-neutral-900 transition-colors"
    >
      Work &amp; Projects
    </a>
    <a
      href="/#skills"
      class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-2 px-3 rounded hover:bg-neutral-900 transition-colors"
    >
      Skills
    </a>
    <a
      href="/#contact"
      class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-2 px-3 rounded hover:bg-neutral-900 transition-colors"
    >
      Contact
    </a>
  </div>
</header>

<script>
  function initHeader() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!btn || !menu || btn.dataset['bound'] === 'true') return;
    btn.dataset['bound'] = 'true';

    const toggle = () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      btn.setAttribute('aria-expanded', String(nextState));

      if (nextState) {
        menu.classList.remove('hidden');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    };

    btn.addEventListener('click', toggle);

    // Close mobile menu when clicking any menu link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
