---
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-surface-bg/85 border-b border-neutral-800/70 pt-[env(safe-area-inset-top,0px)] transition-all duration-300"
  id="main-header"
>
  <div class="max-w-5xl 2xl:max-w-6xl mx-auto px-3.5 sm:px-6 lg:px-8 min-h-16 py-2 flex items-center justify-between gap-3">
    <a
      href="/#home"
      class="shrink-0 font-mono text-base sm:text-lg font-bold tracking-tight text-white hover:text-accent transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded min-h-11 min-w-11"
    >
      <span>{siteData.personal.handle}</span>
      <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
    </a>
    <nav aria-label="Primary" class="hidden sm:flex flex-wrap items-center justify-end gap-1 md:gap-2 min-w-0 text-sm font-medium">
      <a
        href="/#home"
        class="text-neutral-300 hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg px-3 py-2 min-h-11 flex items-center whitespace-nowrap"
      >
        Home
      </a>
      <a
        href="/#about"
        class="text-neutral-300 hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg px-3 py-2 min-h-11 flex items-center whitespace-nowrap"
      >
        About
      </a>
      <a
        href="/#work"
        class="text-neutral-300 hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg px-3 py-2 min-h-11 flex items-center whitespace-nowrap"
      >
        Work
      </a>
      <a
        href="/#skills"
        class="text-neutral-300 hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg px-3 py-2 min-h-11 flex items-center whitespace-nowrap"
      >
        Skills
      </a>
      <a
        href="/#contact"
        class="text-neutral-300 hover:text-accent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-lg px-3 py-2 min-h-11 flex items-center whitespace-nowrap"
      >
        Contact
      </a>
    </nav>
    <div class="sm:hidden shrink-0">
      <button
        id="mobile-menu-toggle"
        popovertarget="mobile-menu"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
        class="min-w-11 min-h-11 p-2 text-neutral-300 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded cursor-pointer flex items-center justify-center transition-[color,transform,scale] duration-150 motion-safe:active:scale-95 motion-reduce:transition-colors"
      >
        <Icon name="mdi:menu" class="h-6 w-6" aria-hidden="true" />
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    popover
    aria-label="Mobile navigation"
    class="fixed top-[calc(4rem+env(safe-area-inset-top,0px))] inset-x-0 w-full m-0 p-4 sm:p-6 pb-[max(1.5rem,env(safe-area-inset-bottom,0px))] bg-surface-bg/95 backdrop-blur-xl border-b border-neutral-800 text-neutral-200 shadow-2xl backdrop:bg-black/60 focus:outline-none sm:hidden"
  >
    <div class="max-w-5xl 2xl:max-w-6xl mx-auto space-y-2">
      <div class="flex items-center justify-between pb-3 mb-2 border-b border-neutral-800/80">
        <span class="font-mono text-xs uppercase tracking-widest text-accent font-bold">
          Navigation
        </span>
        <button
          id="mobile-menu-close"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          type="button"
          aria-label="Close menu"
          class="min-w-11 min-h-11 p-2 text-neutral-400 hover:text-white cursor-pointer flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded transition-[color,transform,scale] duration-150 motion-safe:active:scale-95 motion-reduce:transition-colors"
        >
          <Icon name="mdi:close" class="h-5 w-5" aria-hidden="true" />
        </button>
      </div>

      <a
        href="/#home"
        class="flex items-center min-h-11 text-base font-medium text-neutral-200 hover:text-accent hover:bg-neutral-900/60 active:bg-neutral-800 px-3 py-2.5 rounded-xl transition-colors"
      >
        Home
      </a>
      <a
        href="/#about"
        class="flex items-center min-h-11 text-base font-medium text-neutral-200 hover:text-accent hover:bg-neutral-900/60 active:bg-neutral-800 px-3 py-2.5 rounded-xl transition-colors"
      >
        About &amp; Experience
      </a>
      <a
        href="/#work"
        class="flex items-center min-h-11 text-base font-medium text-neutral-200 hover:text-accent hover:bg-neutral-900/60 active:bg-neutral-800 px-3 py-2.5 rounded-xl transition-colors"
      >
        Work &amp; Projects
      </a>
      <a
        href="/#skills"
        class="flex items-center min-h-11 text-base font-medium text-neutral-200 hover:text-accent hover:bg-neutral-900/60 active:bg-neutral-800 px-3 py-2.5 rounded-xl transition-colors"
      >
        Skills
      </a>
      <a
        href="/#contact"
        class="flex items-center min-h-11 text-base font-medium text-neutral-200 hover:text-accent hover:bg-neutral-900/60 active:bg-neutral-800 px-3 py-2.5 rounded-xl transition-colors"
      >
        Contact
      </a>
    </div>
  </nav>
</header>

<style>
  @supports not selector(:popover-open) {
    #mobile-menu[popover]:not(.is-fallback-open) {
      display: none;
    }

    #mobile-menu[popover].is-fallback-open {
      display: block;
    }
  }
</style>

<script>
  const mobileMenu = document.getElementById('mobile-menu');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');

  if (mobileMenu) {
    const supportsPopover =
      Object.hasOwn(HTMLElement.prototype, 'popover') &&
      typeof mobileMenu.showPopover === 'function' &&
      typeof mobileMenu.hidePopover === 'function';

    if (supportsPopover) {
      mobileMenu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement | null)?.closest('a')) {
          mobileMenu.hidePopover();
        }
      });

      mobileMenu.addEventListener('toggle', (event) => {
        const isExpanded = (event as ToggleEvent).newState === 'open';
        toggleBtn?.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      });

      window.addEventListener('pagehide', () => {
        if (mobileMenu.matches(':popover-open')) {
          mobileMenu.hidePopover();
        }
      });
    } else {
      const setFallbackOpen = (open: boolean, returnFocus = false) => {
        mobileMenu.classList.toggle('is-fallback-open', open);
        toggleBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          closeBtn?.focus();
        } else if (returnFocus) {
          toggleBtn?.focus();
        }
      };

      toggleBtn?.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('is-fallback-open');
        setFallbackOpen(!isOpen, isOpen);
      });

      closeBtn?.addEventListener('click', () => setFallbackOpen(false, true));

      mobileMenu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement | null)?.closest('a')) {
          setFallbackOpen(false);
        }
      });

      document.addEventListener('click', (e) => {
        if (!mobileMenu.classList.contains('is-fallback-open')) return;
        const target = e.target as Node | null;
        if (target && !mobileMenu.contains(target) && !toggleBtn?.contains(target)) {
          setFallbackOpen(false);
        }
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu.classList.contains('is-fallback-open')) {
          setFallbackOpen(false, true);
        }
      });

      window.addEventListener('pagehide', () => setFallbackOpen(false));
    }
  }
</script>
