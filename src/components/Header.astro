---
import { Icon } from 'astro-icon/components';
import { siteData } from '../data/site';
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#0a0a0a]/85 border-b border-neutral-800/70 transition-all duration-300"
  id="main-header"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a
      href="/#home"
      class="font-mono text-lg font-bold tracking-tight text-white hover:text-[#fc7a00] transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded"
    >
      <span>{siteData.personal.handle}</span>
      <span class="inline-block w-2 h-2 rounded-full bg-[#fc7a00] animate-pulse"></span>
    </a>
    <nav class="hidden sm:flex items-center gap-8 text-sm font-medium">
      <a
        href="/#home"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Home
      </a>
      <a
        href="/#about"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        About
      </a>
      <a
        href="/#work"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Work
      </a>
      <a
        href="/#skills"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Skills
      </a>
      <a
        href="/#contact"
        class="text-neutral-300 hover:text-[#fc7a00] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded px-1"
      >
        Contact
      </a>
    </nav>
    <div class="sm:hidden">
      <button
        popovertarget="mobile-menu"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 text-neutral-300 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#fc7a00] rounded cursor-pointer"
      >
        <Icon name="mdi:menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    popover
    class="fixed top-16 inset-x-0 w-full m-0 p-6 bg-[#0a0a0a]/95 backdrop-blur-xl border-b border-neutral-800 text-neutral-200 shadow-2xl backdrop:bg-black/60 focus:outline-none sm:hidden"
  >
    <div class="max-w-5xl mx-auto space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-neutral-800/80">
        <span class="font-mono text-xs uppercase tracking-widest text-[#fc7a00] font-bold">
          Navigation
        </span>
        <button
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          type="button"
          aria-label="Close menu"
          class="p-1 text-neutral-400 hover:text-white cursor-pointer"
        >
          <Icon name="mdi:close" class="h-5 w-5" />
        </button>
      </div>

      <a
        href="/#home"
        class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-1.5 transition-colors"
      >
        Home
      </a>
      <a
        href="/#about"
        class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-1.5 transition-colors"
      >
        About &amp; Experience
      </a>
      <a
        href="/#work"
        class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-1.5 transition-colors"
      >
        Work &amp; Projects
      </a>
      <a
        href="/#skills"
        class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-1.5 transition-colors"
      >
        Skills
      </a>
      <a
        href="/#contact"
        class="block text-base font-medium text-neutral-200 hover:text-[#fc7a00] py-1.5 transition-colors"
      >
        Contact
      </a>
    </div>
  </nav>
</header>

<script>
  // Close the native popover when any navigation link is clicked
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenu) {
    mobileMenu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        mobileMenu.hidePopover();
      }
    });
  }
</script>
