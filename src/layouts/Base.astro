---
import ConsoleSignature from '../components/ConsoleSignature.astro';
import Head from '../components/Head.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  canonicalURL?: URL | undefined;
  lang?: string | undefined;
}

const { title, description, image, canonicalURL, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <Head {title} {description} {image} {canonicalURL} />
    <ClientRouter />
  </head>
  <body class="bg-[#0a0a0a] text-[#fafafa] font-sans antialiased min-h-screen flex flex-col selection:bg-[#fc7a00] selection:text-black">
    <!-- Accessible Skip to Main Content link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#fc7a00] focus:text-black focus:font-semibold focus:rounded-md focus:shadow-xl focus:outline-none transition-all"
    >
      Skip to main content
    </a>

    <slot />

    <ConsoleSignature />
  </body>
</html>
