---
import { Icon } from 'astro-icon/components';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="404 — Page Not Found"
  description="The requested page could not be located."
  noindex={true}
>
  <Header />

  <main
    id="main-content"
    tabindex="-1"
    class="flex-1 w-full flex items-center justify-center px-3.5 sm:px-6 lg:px-8 py-16 sm:py-24 focus:outline-none"
  >
    <div class="text-center min-w-0 w-full max-w-md mx-auto wrap-break-word">
      <span class="font-mono text-5xl sm:text-7xl font-bold text-accent tracking-tight block mb-4">
        404
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3">
        Page Not Found
      </h1>
      <p class="text-neutral-400 text-sm leading-relaxed mb-8">
        The route you are looking for does not exist or has been relocated as
        part of the architecture overhaul.
      </p>

      <a
        href="/#home"
        class="inline-flex items-center justify-center gap-2 min-h-11 px-6 py-3 bg-accent text-black font-mono font-bold text-sm rounded-full hover:bg-accent-hover transition-colors shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
      >
        <Icon name="mdi:arrow-left" class="w-4 h-4 shrink-0 rtl:rotate-180" aria-hidden="true" />
        <span>Return to Homepage</span>
      </a>
    </div>
  </main>

  <Footer />
</Base>
