---
import { Icon } from 'astro-icon/components';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found" description="The requested page could not be located.">
  <Header />

  <main id="main-content" class="min-h-[70vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-md mx-auto">
      <span class="font-mono text-5xl sm:text-7xl font-bold text-[#fc7a00] tracking-tight block mb-4">
        404
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-3">
        Page Not Found
      </h1>
      <p class="text-neutral-400 text-sm leading-relaxed mb-8">
        The route you are looking for does not exist or has been relocated as part of the architecture overhaul.
      </p>

      <a
        href="/#home"
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#fc7a00] text-black font-mono font-bold text-sm rounded-full hover:bg-[#ff9429] transition-colors shadow-lg shadow-[#fc7a00]/20"
      >
        <Icon name="mdi:arrow-left" class="w-4 h-4" />
        <span>Return to Homepage</span>
      </a>
    </div>
  </main>

  <Footer />
</Base>
